# =================================================
# UNIMAG aligned states and watchdogs
# =================================================
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   8.. additional, device specific states
#
# The device logic decodes the plain state (0-5 and the device specific
# ones) into STATE_BASE, and
# STATE_FINAL copies it to STATE_RB. A setpoint or state not reached is a
# software state: the watchdogs below report it in STATE_SM.
#
# Configuration (db macros, also live PVs):
#   SET_TOLERANCE  (A) readback within this of CURRENT_SP counts as reached
#                      (default 1.0, 0 disables the setpoint check)
#   ZERO_TOLERANCE (A) a zero setpoint counts as reached within this
#                      (default 0.5)
#   SET_TIMEOUT_S  (s) how long the setpoint / state may stay unreached
#                      without progress before it is reported (default 30)
# The timeout restarts on progress (readback getting closer to the setpoint),
# on a new setpoint and on a new state command.

record(ao, "$(P):$(R):WAYA:SET_TOLERANCE") {
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1.0)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):WAYA:ZERO_TOLERANCE") {
    field(DESC, "Zero current tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=0.5)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):WAYA:SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# Plain decoded state (0-5 and device specific), written by the device logic
record(ao, "$(P):$(R):WAYA:STATE_BASE") {
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):WAYA:STATE_FINAL")
}

# Device state to STATE_RB
record(calcout, "$(P):$(R):WAYA:STATE_FINAL") {
    field(DESC, "Final state")
    field(INPA, "$(P):$(R):WAYA:STATE_BASE NPP NMS")
    field(CALC, "A")
    field(OUT,  "$(P):$(R):WAYA:STATE_RB PP")
    field(OOPT, "Every Time")
}

# ---------- setpoint watchdog ----------
# Distance of the readback from the setpoint (from zero for a zero setpoint)
record(calc, "$(P):$(R):WAYA:SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):WAYA:CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):WAYA:CURRENT_SP NPP NMS")
    field(INPC, "$(P):$(R):WAYA:ZERO_TOLERANCE NPP NMS")
    field(CALC, "ABS(B)<=C?ABS(A):ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

# Seconds the setpoint has been unreached without progress. Only counts
# while the supply is ON (or in a device specific active state).
record(calc, "$(P):$(R):WAYA:SP_WDOG") {
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYA:SP_ERR PP NMS")
    field(INPB, "$(P):$(R):WAYA:SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):WAYA:ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):WAYA:SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):WAYA:ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):WAYA:CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):WAYA:SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):WAYA:STATE_BASE NPP NMS")
    field(INPI, "$(P):$(R):WAYA:SP_ARMED PP NMS")
    field(CALC, "!I||D<=0||H!=1&&H<8?0:(A<=(ABS(F)<=E?E:D)?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P):$(R):WAYA:SP_NOT_REACHED")
}

record(calc, "$(P):$(R):WAYA:SP_NOT_REACHED") {
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P):$(R):WAYA:SP_WDOG NPP NMS")
    field(INPB, "$(P):$(R):WAYA:SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):WAYA:SP_LAST")
}

record(calc, "$(P):$(R):WAYA:SP_LAST") {
    field(DESC, "Previous setpoint")
    field(INPA, "$(P):$(R):WAYA:CURRENT_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):WAYA:ERR_LAST")
}

record(calc, "$(P):$(R):WAYA:ERR_LAST") {
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P):$(R):WAYA:SP_ERR NPP NMS")
    field(CALC, "A")
    field(FLNK, "$(P):$(R):WAYA:STATE_FINAL")
}

# ---------- state watchdog ----------
# Armed by the first state command after boot, so that a supply left running
# does not raise ST_NOT_REACHED just because STATE_SP boots as OFF.
record(calc, "$(P):$(R):WAYA:ST_ARMED") {
    field(DESC, "State command seen since boot")
    field(INPA, "$(P):$(R):WAYA:STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYA:ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYA:ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# Seconds the commanded state has not been reached. Faults do not count
# (they are shown as such); OFF and STANDBY are both accepted for either.
record(calc, "$(P):$(R):WAYA:ST_WDOG") {
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYA:STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYA:ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYA:STATE_BASE NPP NMS")
    field(INPD, "$(P):$(R):WAYA:ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):WAYA:ST_ARMED PP NMS")
    field(CALC, "!E||C>=3&&C<=5||A!=B||(A=1?C=1:(A=0||A=2?C=0||C=2:1))?0:D+1")
    field(FLNK, "$(P):$(R):WAYA:ST_NOT_REACHED")
}

record(calc, "$(P):$(R):WAYA:ST_NOT_REACHED") {
    field(DESC, "State not reached in time")
    field(INPA, "$(P):$(R):WAYA:ST_WDOG NPP NMS")
    field(INPB, "$(P):$(R):WAYA:SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):WAYA:ST_LAST")
}

record(calc, "$(P):$(R):WAYA:ST_LAST") {
    field(DESC, "Previous state command")
    field(INPA, "$(P):$(R):WAYA:STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):WAYA:STATE_FINAL")
}

# ---------- UNIMAG state machine ----------
# STATE_SM tells what the supply is doing; a setpoint or state not reached is
# a software state, reported here and not in STATE_RB:
#   0 READY | 1 GOTOSET | 2 GOTOSTATE | 3 GOZERO | 4 GOPOS | 5 GONEG
#   6 SPNOTSET (MINOR, = SP_NOT_REACHED) | 7 STATENOTSET (MAJOR, = ST_NOT_REACHED)
# A sequencer, when there is one, publishes its step in STATE_SM_STEP
# (GOZERO / GOPOS / GONEG during a polarity change). Otherwise the readback
# tells GOTOSET (GOZERO for a zero setpoint) and the state watchdog GOTOSTATE.
# STATE_SP = RESET restarts both timeouts, clearing SPNOTSET / STATENOTSET.
record(longout, "$(P):$(R):WAYA:STATE_SM_STEP") {
    field(DESC, "Sequencer step (0 = idle)")
    field(VAL,  "0")
    # STATE_SM_CALC is scanned: a FLNK would not process it, a write to PROC does
    field(OUT,  "$(P):$(R):WAYA:STATE_SM_CALC.PROC")
}

# Armed by the first setpoint change after boot: CURRENT_SP boots as 0 and
# is not read from the supply, so a supply left running is not reported.
record(calc, "$(P):$(R):WAYA:SP_ARMED") {
    field(DESC, "Setpoint command seen since boot")
    field(INPA, "$(P):$(R):WAYA:CURRENT_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYA:SP_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYA:SP_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

record(calc, "$(P):$(R):WAYA:SP_BUSY") {
    field(DESC, "Going to the setpoint")
    field(INPA, "$(P):$(R):WAYA:SP_ERR NPP NMS")
    field(INPB, "$(P):$(R):WAYA:SET_TOLERANCE NPP NMS")
    field(INPC, "$(P):$(R):WAYA:ZERO_TOLERANCE NPP NMS")
    field(INPD, "$(P):$(R):WAYA:CURRENT_SP NPP NMS")
    field(INPE, "$(P):$(R):WAYA:SP_ARMED NPP NMS")
    field(INPF, "$(P):$(R):WAYA:STATE_BASE NPP NMS")
    field(CALC, "E&&B>0&&(F=1||F>=8)&&A>(ABS(D)<=C?C:B)?(ABS(D)<=C?2:1):0")
}

record(calcout, "$(P):$(R):WAYA:STATE_SM_CALC") {
    field(DESC, "Compute STATE_SM")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYA:STATE_SM_STEP NPP NMS")
    field(INPB, "$(P):$(R):WAYA:ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):WAYA:SP_NOT_REACHED NPP NMS")
    field(INPD, "$(P):$(R):WAYA:ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):WAYA:SP_BUSY PP NMS")
    field(CALC, "B?7:(C?6:(A?A:(D>0?2:(E=2?3:(E?1:0)))))")
    field(OUT,  "$(P):$(R):WAYA:STATE_SM PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P):$(R):WAYA:STATE_SM") {
    field(DESC, "UNIMAG state machine")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "READY")
    field(ONVL, "1")
    field(ONST, "GOTOSET")
    field(TWVL, "2")
    field(TWST, "GOTOSTATE")
    field(THVL, "3")
    field(THST, "GOZERO")
    field(FRVL, "4")
    field(FRST, "GOPOS")
    field(FVVL, "5")
    field(FVST, "GONEG")
    field(SXVL, "6")
    field(SXST, "SPNOTSET")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "STATENOTSET")
    field(SVSV, "MAJOR")
}

record(calcout, "$(P):$(R):WAYA:SM_RESET") {
    field(DESC, "STATE_SP RESET clears the watchdogs")
    field(INPA, "$(P):$(R):WAYA:STATE_SP NPP NMS")
    field(CALC, "A=3")
    field(OCAL, "0")
    field(DOPT, "Use OCAL")
    field(OUT,  "$(P):$(R):WAYA:WDOG_CLEAR PP")
    field(OOPT, "When Non-zero")
    field(FLNK, "$(P):$(R):WayA_state_to_enable")
}

record(dfanout, "$(P):$(R):WAYA:WDOG_CLEAR") {
    field(DESC, "Clear the NOT_REACHED watchdogs")
    field(VAL,  "0")
    field(OUTA, "$(P):$(R):WAYA:SP_WDOG.VAL NPP")
    field(OUTB, "$(P):$(R):WAYA:ST_WDOG.VAL NPP")
    field(FLNK, "$(P):$(R):WAYA:WDOG_CLEAR_FAN")
}

record(fanout, "$(P):$(R):WAYA:WDOG_CLEAR_FAN") {
    field(DESC, "Re-evaluate the NOT_REACHED flags")
    field(LNK1, "$(P):$(R):WAYA:SP_NOT_REACHED")
    field(LNK2, "$(P):$(R):WAYA:ST_NOT_REACHED")
}


# =================================================
# UNIMAG aligned states and watchdogs
# =================================================
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   8.. additional, device specific states
#
# The device logic decodes the plain state (0-5 and the device specific
# ones) into STATE_BASE, and
# STATE_FINAL copies it to STATE_RB. A setpoint or state not reached is a
# software state: the watchdogs below report it in STATE_SM.
#
# Configuration (db macros, also live PVs):
#   SET_TOLERANCE  (A) readback within this of CURRENT_SP counts as reached
#                      (default 1.0, 0 disables the setpoint check)
#   ZERO_TOLERANCE (A) a zero setpoint counts as reached within this
#                      (default 0.5)
#   SET_TIMEOUT_S  (s) how long the setpoint / state may stay unreached
#                      without progress before it is reported (default 30)
# The timeout restarts on progress (readback getting closer to the setpoint),
# on a new setpoint and on a new state command.

record(ao, "$(P):$(R):WAYB:SET_TOLERANCE") {
    field(DESC, "Current setpoint tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1.0)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):WAYB:ZERO_TOLERANCE") {
    field(DESC, "Zero current tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=0.5)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "1000")
}

record(ao, "$(P):$(R):WAYB:SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# Plain decoded state (0-5 and device specific), written by the device logic
record(ao, "$(P):$(R):WAYB:STATE_BASE") {
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):WAYB:STATE_FINAL")
}

# Device state to STATE_RB
record(calcout, "$(P):$(R):WAYB:STATE_FINAL") {
    field(DESC, "Final state")
    field(INPA, "$(P):$(R):WAYB:STATE_BASE NPP NMS")
    field(CALC, "A")
    field(OUT,  "$(P):$(R):WAYB:STATE_RB PP")
    field(OOPT, "Every Time")
}

# ---------- setpoint watchdog ----------
# Distance of the readback from the setpoint (from zero for a zero setpoint)
record(calc, "$(P):$(R):WAYB:SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):WAYB:CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):WAYB:CURRENT_SP NPP NMS")
    field(INPC, "$(P):$(R):WAYB:ZERO_TOLERANCE NPP NMS")
    field(CALC, "ABS(B)<=C?ABS(A):ABS(A-B)")
    field(EGU,  "A")
    field(PREC, "3")
}

# Seconds the setpoint has been unreached without progress. Only counts
# while the supply is ON (or in a device specific active state).
record(calc, "$(P):$(R):WAYB:SP_WDOG") {
    field(DESC, "Setpoint unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYB:SP_ERR PP NMS")
    field(INPB, "$(P):$(R):WAYB:SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):WAYB:ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):WAYB:SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):WAYB:ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):WAYB:CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):WAYB:SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):WAYB:STATE_BASE NPP NMS")
    field(INPI, "$(P):$(R):WAYB:SP_ARMED PP NMS")
    field(CALC, "!I||D<=0||H!=1&&H<8?0:(A<=(ABS(F)<=E?E:D)?0:(F!=G||A<C-D/20?0:B+1))")
    field(FLNK, "$(P):$(R):WAYB:SP_NOT_REACHED")
}

record(calc, "$(P):$(R):WAYB:SP_NOT_REACHED") {
    field(DESC, "Setpoint not reached in time")
    field(INPA, "$(P):$(R):WAYB:SP_WDOG NPP NMS")
    field(INPB, "$(P):$(R):WAYB:SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):WAYB:SP_LAST")
}

record(calc, "$(P):$(R):WAYB:SP_LAST") {
    field(DESC, "Previous setpoint")
    field(INPA, "$(P):$(R):WAYB:CURRENT_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):WAYB:ERR_LAST")
}

record(calc, "$(P):$(R):WAYB:ERR_LAST") {
    field(DESC, "Previous setpoint error")
    field(INPA, "$(P):$(R):WAYB:SP_ERR NPP NMS")
    field(CALC, "A")
    field(FLNK, "$(P):$(R):WAYB:STATE_FINAL")
}

# ---------- state watchdog ----------
# Armed by the first state command after boot, so that a supply left running
# does not raise ST_NOT_REACHED just because STATE_SP boots as OFF.
record(calc, "$(P):$(R):WAYB:ST_ARMED") {
    field(DESC, "State command seen since boot")
    field(INPA, "$(P):$(R):WAYB:STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYB:ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYB:ST_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

# Seconds the commanded state has not been reached. Faults do not count
# (they are shown as such); OFF and STANDBY are both accepted for either.
record(calc, "$(P):$(R):WAYB:ST_WDOG") {
    field(DESC, "State unreached seconds")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYB:STATE_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYB:ST_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYB:STATE_BASE NPP NMS")
    field(INPD, "$(P):$(R):WAYB:ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):WAYB:ST_ARMED PP NMS")
    field(CALC, "!E||C>=3&&C<=5||A!=B||(A=1?C=1:(A=0||A=2?C=0||C=2:1))?0:D+1")
    field(FLNK, "$(P):$(R):WAYB:ST_NOT_REACHED")
}

record(calc, "$(P):$(R):WAYB:ST_NOT_REACHED") {
    field(DESC, "State not reached in time")
    field(INPA, "$(P):$(R):WAYB:ST_WDOG NPP NMS")
    field(INPB, "$(P):$(R):WAYB:SET_TIMEOUT_S NPP NMS")
    field(CALC, "A>=B")
    field(FLNK, "$(P):$(R):WAYB:ST_LAST")
}

record(calc, "$(P):$(R):WAYB:ST_LAST") {
    field(DESC, "Previous state command")
    field(INPA, "$(P):$(R):WAYB:STATE_SP NPP NMS")
    field(CALC, "A")
    field(PINI, "YES")
    field(FLNK, "$(P):$(R):WAYB:STATE_FINAL")
}

# ---------- UNIMAG state machine ----------
# STATE_SM tells what the supply is doing; a setpoint or state not reached is
# a software state, reported here and not in STATE_RB:
#   0 READY | 1 GOTOSET | 2 GOTOSTATE | 3 GOZERO | 4 GOPOS | 5 GONEG
#   6 SPNOTSET (MINOR, = SP_NOT_REACHED) | 7 STATENOTSET (MAJOR, = ST_NOT_REACHED)
# A sequencer, when there is one, publishes its step in STATE_SM_STEP
# (GOZERO / GOPOS / GONEG during a polarity change). Otherwise the readback
# tells GOTOSET (GOZERO for a zero setpoint) and the state watchdog GOTOSTATE.
# STATE_SP = RESET restarts both timeouts, clearing SPNOTSET / STATENOTSET.
record(longout, "$(P):$(R):WAYB:STATE_SM_STEP") {
    field(DESC, "Sequencer step (0 = idle)")
    field(VAL,  "0")
    # STATE_SM_CALC is scanned: a FLNK would not process it, a write to PROC does
    field(OUT,  "$(P):$(R):WAYB:STATE_SM_CALC.PROC")
}

# Armed by the first setpoint change after boot: CURRENT_SP boots as 0 and
# is not read from the supply, so a supply left running is not reported.
record(calc, "$(P):$(R):WAYB:SP_ARMED") {
    field(DESC, "Setpoint command seen since boot")
    field(INPA, "$(P):$(R):WAYB:CURRENT_SP NPP NMS")
    field(INPB, "$(P):$(R):WAYB:SP_LAST NPP NMS")
    field(INPC, "$(P):$(R):WAYB:SP_ARMED NPP NMS")
    field(CALC, "C||A!=B")
}

record(calc, "$(P):$(R):WAYB:SP_BUSY") {
    field(DESC, "Going to the setpoint")
    field(INPA, "$(P):$(R):WAYB:SP_ERR NPP NMS")
    field(INPB, "$(P):$(R):WAYB:SET_TOLERANCE NPP NMS")
    field(INPC, "$(P):$(R):WAYB:ZERO_TOLERANCE NPP NMS")
    field(INPD, "$(P):$(R):WAYB:CURRENT_SP NPP NMS")
    field(INPE, "$(P):$(R):WAYB:SP_ARMED NPP NMS")
    field(INPF, "$(P):$(R):WAYB:STATE_BASE NPP NMS")
    field(CALC, "E&&B>0&&(F=1||F>=8)&&A>(ABS(D)<=C?C:B)?(ABS(D)<=C?2:1):0")
}

record(calcout, "$(P):$(R):WAYB:STATE_SM_CALC") {
    field(DESC, "Compute STATE_SM")
    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYB:STATE_SM_STEP NPP NMS")
    field(INPB, "$(P):$(R):WAYB:ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):WAYB:SP_NOT_REACHED NPP NMS")
    field(INPD, "$(P):$(R):WAYB:ST_WDOG NPP NMS")
    field(INPE, "$(P):$(R):WAYB:SP_BUSY PP NMS")
    field(CALC, "B?7:(C?6:(A?A:(D>0?2:(E=2?3:(E?1:0)))))")
    field(OUT,  "$(P):$(R):WAYB:STATE_SM PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P):$(R):WAYB:STATE_SM") {
    field(DESC, "UNIMAG state machine")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "READY")
    field(ONVL, "1")
    field(ONST, "GOTOSET")
    field(TWVL, "2")
    field(TWST, "GOTOSTATE")
    field(THVL, "3")
    field(THST, "GOZERO")
    field(FRVL, "4")
    field(FRST, "GOPOS")
    field(FVVL, "5")
    field(FVST, "GONEG")
    field(SXVL, "6")
    field(SXST, "SPNOTSET")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "STATENOTSET")
    field(SVSV, "MAJOR")
}

record(calcout, "$(P):$(R):WAYB:SM_RESET") {
    field(DESC, "STATE_SP RESET clears the watchdogs")
    field(INPA, "$(P):$(R):WAYB:STATE_SP NPP NMS")
    field(CALC, "A=3")
    field(OCAL, "0")
    field(DOPT, "Use OCAL")
    field(OUT,  "$(P):$(R):WAYB:WDOG_CLEAR PP")
    field(OOPT, "When Non-zero")
    field(FLNK, "$(P):$(R):WayB_state_to_enable")
}

record(dfanout, "$(P):$(R):WAYB:WDOG_CLEAR") {
    field(DESC, "Clear the NOT_REACHED watchdogs")
    field(VAL,  "0")
    field(OUTA, "$(P):$(R):WAYB:SP_WDOG.VAL NPP")
    field(OUTB, "$(P):$(R):WAYB:ST_WDOG.VAL NPP")
    field(FLNK, "$(P):$(R):WAYB:WDOG_CLEAR_FAN")
}

record(fanout, "$(P):$(R):WAYB:WDOG_CLEAR_FAN") {
    field(DESC, "Re-evaluate the NOT_REACHED flags")
    field(LNK1, "$(P):$(R):WAYB:SP_NOT_REACHED")
    field(LNK2, "$(P):$(R):WAYB:ST_NOT_REACHED")
}


