    field(SCAN, "1 second")
    field(INPA, "$(P):$(R):WAYC:SP_ERR PP NMS")
    field(INPB, "$(P):$(R):WAYC:SP_WDOG NPP NMS")
    field(INPC, "$(P):$(R):WAYC:ERR_LAST NPP NMS")
    field(INPD, "$(P):$(R):WAYC:SET_TOLERANCE NPP NMS")
    field(INPE, "$(P):$(R):WAYC:ZERO_TOLERANCE NPP NMS")
    field(INPF, "$(P):$(R):WAYC:CURRENT_SP NPP NMS")
    field(INPG, "$(P):$(R):WAYC:SP_LAST NPP NMS")
    field(INPH, "$(P):$(R):WAYC:STATE_BASE NPP NMS")
