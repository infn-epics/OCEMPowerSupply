record(calc, "$(P):$(R):WAYC:SP_ERR") {
    field(DESC, "Setpoint error")
    field(INPA, "$(P):$(R):WAYC:CURRENT_RB NPP NMS")
    field(INPB, "$(P):$(R):WAYC:CURRENT_SP NPP NMS")
